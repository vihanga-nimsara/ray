{
  "name": "ray-launcher",
  "productName": "Ray",
  "version": "0.1.0",
  "private": true,
  "description": "A background Windows app with one floating search bar. Finds and launches Start menu and Microsoft Store apps.",
  "main": "electron/main.js",
  "author": "Ray",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/icons-from-logo.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.ray.launcher",
    "productName": "Ray",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/tray.png",
      "assets/tray@2x.png",
      "assets/fonts/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ray",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
